# Copy to self-host.env; fill using your own isolated Supabase deployment.
# Never commit the resulting file. Public keys must match the server project.
VITE_SUPABASE_URL=https://example.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_URL=https://example.invalid
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
OPENAI_API_KEY=replace-me
SUPABASE_PUBLISHABLE_KEY=replace-me
VITE_SUPABASE_PROJECT_ID=replace-me

# Agent API and write capabilities are off unless explicitly enabled with 1.
AUTOSOCIALS_AGENT_API_ENABLED=0
AUTOSOCIALS_AGENT_DRAFTS_ENABLED=0
AUTOSOCIALS_AGENT_PUBLISHING_ENABLED=0
AUTOSOCIALS_AGENT_TILE_PLANNING_ENABLED=0
# Replace with this installation's own canonical HTTPS origin before enabling.
AUTOSOCIALS_AGENT_ORIGIN=https://example.invalid
# Optional comma-separated browser origins. Only add trusted origins.
AUTOSOCIALS_AGENT_ALLOWED_ORIGINS=
# Webhook delivery remains off unless explicitly set to true.
AGENT_WEBHOOK_DELIVERY_ENABLED=false
# AGENT_WEBHOOK_ENCRYPTION_KEY must be a unique, securely stored base64-encoded
# 32-byte key. Configure privately; do not put a real key in this example.
AUTOSOCIALS_AGENT_RESEARCH_PROVIDER_ENABLED=0
# Virlo is an optional metered provider and remains disabled by default.
VIRLO_ENABLED=false
# VIRLO_API_KEY, APIFY_API_TOKEN and FIRECRAWL_API_KEY belong only in the
# server runtime when their corresponding optional features are enabled.
# Optional LinkedIn edge-function setting: set to your exact public HTTPS app
# origin when self-hosting; leave unset for the established AutoSocials origin.
# LINKEDIN_OAUTH_APP_ORIGIN=https://your-installation.example
